<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nowPlayingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_nowplaying_bg">

    <!-- Apple Music Top Grab Handle Pill + Dismiss Area -->
    <FrameLayout
        android:id="@+id/topGrabContainer"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="64dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/bg_sheet_handle"
            app:tint="#66FFFFFF" />

        <TextView
            android:id="@+id/playingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="28dp"
            android:alpha="0.7"
            android:letterSpacing="0.06"
            android:text="@string/now_playing"
            android:textAllCaps="true"
            android:textColor="#CCFFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Apple Music Floating Square Album Art Container (scales between 1.0f playing and 0.80f paused) -->
    <FrameLayout
        android:id="@+id/artContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/infoBlock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topGrabContainer">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/art"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="center"
            android:elevation="24dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedArt" />

        <!-- Synced Lyrics / Track Details Overlay (toggled from bottom Lyrics button) -->
        <ScrollView
            android:id="@+id/lyricsOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#B3141418"
            android:padding="20dp"
            android:scrollbars="none"
            android:visibility="gone">

            <TextView
                android:id="@+id/lyricsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.3"
                android:textColor="#F2FFFFFF"
                android:textSize="17sp" />
        </ScrollView>
    </FrameLayout>

    <!-- Apple Music Bottom Controls Stack -->
    <LinearLayout
        android:id="@+id/infoBlock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Title + Artist + Favorite Star/Heart Pill + More (•••) Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:letterSpacing="-0.02"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#B3FFFFFF"
                    android:textSize="17sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/favoriteButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_np_glass_circle"
                android:contentDescription="@string/action_favorite"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_favorite_border"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/moreOptionsButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_np_glass_circle"
                android:contentDescription="More options"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_np_more"
                app:tint="@color/white" />
        </LinearLayout>

        <!-- Apple Music Progress Scrubber -->
        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxHeight="6dp"
            android:minHeight="6dp"
            android:paddingStart="0dp"
            android:paddingTop="13dp"
            android:paddingEnd="0dp"
            android:paddingBottom="13dp"
            android:progressDrawable="@drawable/np_scrubber"
            android:splitTrack="false"
            android:thumb="@null" />

        <!-- Elapsed · Lossless Badge · Remaining -->
        <LinearLayout
            android:id="@+id/timeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/position"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textColor="#99FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/losslessBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_np_glass_pill"
                android:letterSpacing="0.06"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="AUDIO"
                android:textColor="#CCFFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/duration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="-0:00"
                android:textColor="#99FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Apple Music Giant Crisp White Transport Controls -->
        <LinearLayout
            android:id="@+id/controlsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/prevButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_previous"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_previous"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/playPauseButton"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginStart="38dp"
                android:layout_marginEnd="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_play"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play_arrow"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/nextButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_next"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_next"
                app:tint="@color/white" />
        </LinearLayout>

        <!-- Apple Music Hardware Volume Slider Bar -->
        <LinearLayout
            android:id="@+id/volumeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:alpha="0.65"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_np_volume_low"
                app:tint="@color/white" />

            <SeekBar
                android:id="@+id/volumeSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:maxHeight="6dp"
                android:minHeight="6dp"
                android:paddingStart="0dp"
                android:paddingTop="13dp"
                android:paddingEnd="0dp"
                android:paddingBottom="13dp"
                android:progressDrawable="@drawable/np_scrubber"
                android:splitTrack="false"
                android:thumb="@null" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:alpha="0.9"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_np_volume_high"
                app:tint="@color/white" />
        </LinearLayout>

        <!-- Apple Music Bottom 4-Icon Action Bar (Lyrics · Station/AirPlay · Download · Queue) -->
        <LinearLayout
            android:id="@+id/actionsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_np_glass_pill"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/lyricsButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:alpha="0.8"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Track info"
                android:src="@drawable/ic_info"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/radioButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:alpha="0.8"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/start_radio"
                android:src="@drawable/ic_radio"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/downloadButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:alpha="0.8"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_download"
                android:src="@drawable/ic_download"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/queueButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:alpha="0.85"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_queue"
                android:src="@drawable/ic_queue_music"
                app:tint="@color/white" />
        </LinearLayout>

        <TextView
            android:id="@+id/downloadStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Apple Music Translucent Up Next Pill -->
        <LinearLayout
            android:id="@+id/upNextCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_np_glass"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="9dp"
            android:paddingEnd="12dp"
            android:paddingBottom="9dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/upNextLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="@string/up_next_label"
                    android:textAllCaps="true"
                    android:textColor="@color/music_green"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/upNextTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="10dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_queue_music"
                app:tint="#CCFFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/white"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
