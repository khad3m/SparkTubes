<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nowPlayingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_nowplaying_bg">

    <!-- Apple Music Top Grab Handle Pill + Upper-Left Dual Mode Switcher -->
    <FrameLayout
        android:id="@+id/topGrabContainer"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingTop="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Upper-Left Dual Mini Buttons: [Music/Audio (Active)] & [Video] -->
        <LinearLayout
            android:id="@+id/topLeftModeSwitcher"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_mode_switch_capsule"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="3dp">

            <!-- Icon-only mode switcher (v1.7.2): the old wide labeled buttons
                 collided with the centered grab-handle pill on narrow screens. -->
            <LinearLayout
                android:id="@+id/miniMusicBtn"
                android:layout_width="34dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_mode_switch_active"
                android:clickable="true"
                android:contentDescription="@string/switch_to_audio"
                android:focusable="true"
                android:gravity="center">

                <ImageView
                    android:id="@+id/miniMusicIcon"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_headset"
                    app:tint="@color/white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/miniVideoBtn"
                android:layout_width="34dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_mode_switch_inactive"
                android:clickable="true"
                android:contentDescription="@string/switch_to_video"
                android:focusable="true"
                android:gravity="center">

                <ImageView
                    android:id="@+id/miniVideoIcon"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_video_cam"
                    app:tint="#CCFFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_np_glass_circle_inset"
            android:contentDescription="@string/cd_back"
            android:padding="9dp"
            android:rotation="180"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_up"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/playingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="20dp"
            android:alpha="0.7"
            android:letterSpacing="0.06"
            android:text="@string/now_playing"
            android:textAllCaps="true"
            android:textColor="#CCFFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Apple Music Floating Square Album Art Container + Tap-to-Seek Synced Lyrics Overlay -->
    <FrameLayout
        android:id="@+id/artContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@id/infoBlock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topGrabContainer">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/art"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_gravity="center"
            android:elevation="24dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedArt" />

        <!-- Real-Time Tap-to-Seek Synced Lyrics Overlay -->
        <ScrollView
            android:id="@+id/lyricsOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#B3141418"
            android:padding="18dp"
            android:scrollbars="none"
            android:visibility="gone">

            <TextView
                android:id="@+id/lyricsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.35"
                android:textColor="#F2FFFFFF"
                android:textSize="17sp" />
        </ScrollView>
    </FrameLayout>

    <!-- Apple Music Bottom Controls Stack -->
    <LinearLayout
        android:id="@+id/infoBlock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Live Beat-Reactive Audio Spectrum Visualizer -->
        <com.sparktube.app.ui.music.AudioVisualizerView
            android:id="@+id/audioVisualizer"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_marginBottom="6dp" />

        <!-- Title + Artist + Favorite Star/Heart Pill + More (•••) Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:letterSpacing="-0.02"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#B3FFFFFF"
                    android:textSize="17sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/favoriteButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_np_glass_circle_inset"
                android:contentDescription="@string/action_favorite"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_favorite_border"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/moreOptionsButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_np_glass_circle_inset"
                android:contentDescription="More options"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_np_more"
                app:tint="@color/white" />
        </LinearLayout>

        <!-- Apple Music Luminous Progress Scrubber with Glowing Pearl Thumb & Pulse Effect -->
        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:contentDescription="Playback position"
            android:maxHeight="7dp"
            android:minHeight="7dp"
            android:paddingStart="6dp"
            android:paddingTop="12dp"
            android:paddingEnd="6dp"
            android:paddingBottom="12dp"
            android:progressDrawable="@drawable/np_scrubber"
            android:splitTrack="false"
            android:thumb="@drawable/np_scrubber_thumb"
            android:thumbOffset="6dp" />

        <!-- Elapsed · Center Status Badge (Synced Lyrics / Sleep Timer / EQ) · Remaining -->
        <LinearLayout
            android:id="@+id/timeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/position"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/scrubberEffectBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_np_glass_pill"
                android:letterSpacing="0.06"
                android:paddingStart="10dp"
                android:paddingTop="2dp"
                android:paddingEnd="10dp"
                android:paddingBottom="2dp"
                android:text="LOSSLESS · AUDIO"
                android:textColor="@color/np_accent_text"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/duration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="-0:00"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Apple Music Giant Crisp White Transport Controls -->
        <LinearLayout
            android:id="@+id/controlsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/shuffleButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Shuffle"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_shuffle"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/prevButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_previous"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_previous"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/playPauseButton"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_play"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play_arrow"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/nextButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_next"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_next"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/repeatButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Repeat"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_repeat"
                app:tint="@color/white" />
        </LinearLayout>

        <!-- Apple Music Hardware Volume Slider Bar -->
        <LinearLayout
            android:id="@+id/volumeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:alpha="0.65"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_np_volume_low"
                app:tint="@color/white" />

            <SeekBar
                android:id="@+id/volumeSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:contentDescription="Volume"
                android:maxHeight="6dp"
                android:minHeight="6dp"
                android:paddingStart="0dp"
                android:paddingTop="13dp"
                android:paddingEnd="0dp"
                android:paddingBottom="13dp"
                android:progressDrawable="@drawable/np_scrubber"
                android:splitTrack="false"
                android:thumb="@null" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:alpha="0.9"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_np_volume_high"
                app:tint="@color/white" />
        </LinearLayout>

        <!-- Apple Music Bottom 5-Icon Action Bar (Lyrics · Radio · Sleep Timer · Download · Queue) -->
        <LinearLayout
            android:id="@+id/actionsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_np_glass_pill"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/lyricsButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:alpha="0.85"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Synced Lyrics"
                android:src="@drawable/ic_info"
                android:visibility="gone"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/radioButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:alpha="0.85"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/start_radio"
                android:src="@drawable/ic_radio"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/sleepTimerButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:alpha="0.85"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Sleep timer &amp; Audio EQ"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_sleep_timer"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/downloadButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:alpha="0.85"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_download"
                android:src="@drawable/ic_download"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/queueButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:alpha="0.85"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_queue"
                android:src="@drawable/ic_queue_music"
                app:tint="@color/white" />
        </LinearLayout>

        <!-- Live Offline Download Progress Bar Card -->
        <LinearLayout
            android:id="@+id/downloadProgressCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_np_glass"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/downloadStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/downloadProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="5dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/np_scrubber" />
        </LinearLayout>

        <!-- Apple Music Translucent Up Next Pill -->
        <LinearLayout
            android:id="@+id/upNextCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_np_glass"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="9dp"
            android:paddingEnd="12dp"
            android:paddingBottom="9dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/upNextLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/up_next_label"
                    android:textAllCaps="false"
                    android:textColor="@color/np_accent_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/upNextTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="10dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_queue_music"
                app:tint="#CCFFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/white"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
