<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ambient">

    <!-- YouTube Ambient Cinema Glow (Ambilight halo behind & below the 16:9 player) -->
    <View
        android:id="@+id/ambientCinemaGlow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="-42dp"
        android:alpha="0.75"
        app:layout_constraintBottom_toBottomOf="@id/playerView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/playerView" />

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:controller_layout_id="@layout/player_controller"
        app:resize_mode="fit"
        app:show_timeout="3500"
        app:surface_type="texture_view"
        app:use_controller="true" />

    <!-- Live Bangla Auto-Translate & Original Subtitle Frosted Glass Banner -->
    <TextView
        android:id="@+id/subtitleBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="48dp"
        android:background="@drawable/bg_duration_glass"
        android:elevation="12dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:maxWidth="540dp"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/playerView"
        app:layout_constraintEnd_toEndOf="@id/playerView"
        app:layout_constraintStart_toStartOf="@id/playerView" />

    <!-- Screen Lock Pill Button (shown when screen is locked & user taps the video) -->
    <LinearLayout
        android:id="@+id/unlockScreenButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_mode_switch_capsule"
        android:clickable="true"
        android:elevation="24dp"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/playerView"
        app:layout_constraintEnd_toEndOf="@id/playerView"
        app:layout_constraintStart_toStartOf="@id/playerView">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_lock_open"
            app:tint="?attr/accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/tap_to_unlock"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Double-Tap Seek & Long-Press 2x Speed Pill Indicator -->
    <TextView
        android:id="@+id/gestureSeekPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_duration_glass"
        android:elevation="14dp"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="⏩ 2.0x Speed"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/playerView" />

    <!-- Brightness / volume HUD (swipe left / right side of the video) -->
    <LinearLayout
        android:id="@+id/gestureHud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_duration_glass"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/playerView">

        <ImageView
            android:id="@+id/hudIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_np_volume_high" />

        <ProgressBar
            android:id="@+id/hudBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="110dp"
            android:layout_height="6dp"
            android:layout_marginStart="10dp"
            android:max="100"
            android:progressDrawable="@drawable/np_scrubber" />

        <TextView
            android:id="@+id/hudText"
            android:layout_width="38dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:gravity="end"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Upper-Left Dual Mini Buttons: [Music/Audio] & [Video] — icon-only (v1.7.0) -->
    <LinearLayout
        android:id="@+id/topLeftModeSwitcher"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_mode_switch_capsule"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="3dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/miniMusicBtn"
            android:layout_width="34dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_mode_switch_inactive"
            android:clickable="true"
            android:contentDescription="@string/switch_to_audio"
            android:focusable="true"
            android:gravity="center">

            <ImageView
                android:id="@+id/miniMusicIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_headset"
                app:tint="#CCFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/miniVideoBtn"
            android:layout_width="34dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_mode_switch_active"
            android:clickable="true"
            android:contentDescription="@string/switch_to_video"
            android:focusable="true"
            android:gravity="center">

            <ImageView
                android:id="@+id/miniVideoIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_video_cam"
                app:tint="@color/white" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_np_glass_circle_inset"
        android:padding="12dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_arrow_back"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <ImageButton
        android:id="@+id/fullscreenButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_np_glass_circle_inset"
        android:padding="12dp"
        android:contentDescription="@string/action_fullscreen"
        android:src="@drawable/ic_expand"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <!-- Screen Lock Button -->
    <ImageButton
        android:id="@+id/lockButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_np_glass_circle_inset"
        android:contentDescription="@string/action_screen_lock"
        android:padding="13dp"
        android:src="@drawable/ic_lock"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/fullscreenButton"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <!-- Bangla Auto-Translate Subtitles (CC) Button -->
    <ImageButton
        android:id="@+id/ccButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_np_glass_circle_inset"
        android:contentDescription="@string/subtitles_section"
        android:padding="13dp"
        android:src="@drawable/ic_subtitles"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/lockButton"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <ImageButton
        android:id="@+id/scaleButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_np_glass_circle_inset"
        android:padding="12dp"
        android:contentDescription="@string/action_scale_mode"
        android:src="@drawable/ic_aspect_ratio"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/fullscreenButton"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <!-- Playback speed icon (kept gone; moved into Settings grid) -->
    <ImageButton
        android:id="@+id/speedButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_np_glass_circle_inset"
        android:contentDescription="@string/settings_speed_section"
        android:padding="12dp"
        android:src="@drawable/ic_speed"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/scaleButton"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <!-- Fullscreen Upper-Right "More Videos Grid" Button -->
    <ImageButton
        android:id="@+id/fullscreenVideosGridBtn"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_np_glass_circle_inset"
        android:contentDescription="More videos grid"
        android:padding="13dp"
        android:src="@drawable/ic_grid_videos"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/fullscreenButton"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <!-- Fullscreen Semi-Transparent Scrollable Video Card Grid Overlay Drawer (Right Side) -->
    <LinearLayout
        android:id="@+id/fullscreenGridOverlay"
        android:layout_width="340dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_fullscreen_drawer_glass"
        android:clickable="true"
        android:elevation="22dp"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="More Videos"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/closeFullscreenGridBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_close"
                android:padding="11dp"
                android:src="@drawable/ic_close"
                app:tint="@color/white" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/fullscreenGridRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="vertical" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/playerView">

        <LinearLayout
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="-0.01"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:textColor="@color/on_surface"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/descCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_soft"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/descHeaderTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="-0.01"
                        android:text="Description"
                        android:textColor="@color/on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/qualityBadgeInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_duration_glass"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:text="HD"
                        android:textColor="?attr/accent"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/descChevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:rotation="180"
                        android:src="@drawable/ic_chevron_up"
                        app:tint="@color/on_surface_variant" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/descBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/views"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/on_surface"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/descToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/desc_show_less"
                        android:textColor="?attr/accent"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_soft"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/channelAvatar"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/CircleImage" />

                <LinearLayout
                    android:id="@+id/channelInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/channelName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/on_surface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/channelSubs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/subscribeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_subscribe_off"
                    android:gravity="center"
                    android:minWidth="0dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="@string/subscribe"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/actionRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/actionFavorite"
                        style="@style/ActionPill">

                        <ImageView
                            android:id="@+id/actionFavoriteIcon"
                            style="@style/ActionPillIcon"
                            android:src="@drawable/ic_favorite_border"
                            app:tint="@color/on_surface" />

                        <TextView
                            android:id="@+id/actionFavoriteLabel"
                            style="@style/ActionPillText"
                            android:text="@string/action_favorite" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/actionLikesDislikes"
                        style="@style/ActionPill">

                        <ImageView
                            style="@style/ActionPillIcon"
                            android:src="@drawable/ic_thumb_up"
                            app:tint="@color/on_surface" />

                        <TextView
                            android:id="@+id/actionLikesDislikesLabel"
                            style="@style/ActionPillText"
                            android:text="Likes" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/actionSubtitles"
                        style="@style/ActionPill">

                        <ImageView
                            android:id="@+id/actionSubtitlesIcon"
                            style="@style/ActionPillIcon"
                            android:src="@drawable/ic_subtitles"
                            app:tint="?attr/accent" />

                        <TextView
                            android:id="@+id/actionSubtitlesLabel"
                            style="@style/ActionPillText"
                            android:text="@string/subtitles_bangla_auto" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/actionBackground"
                        style="@style/ActionPill">

                        <ImageView
                            style="@style/ActionPillIcon"
                            android:src="@drawable/ic_headset"
                            app:tint="?attr/accent" />

                        <TextView
                            style="@style/ActionPillText"
                            android:text="@string/action_background" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/actionDownload"
                        style="@style/ActionPill">

                        <ImageView
                            android:id="@+id/actionDownloadIcon"
                            style="@style/ActionPillIcon"
                            android:src="@drawable/ic_download"
                            app:tint="@color/on_surface" />

                        <TextView
                            android:id="@+id/actionDownloadLabel"
                            style="@style/ActionPillText"
                            android:text="@string/action_download" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/actionPlaylist"
                        style="@style/ActionPill">

                        <ImageView
                            style="@style/ActionPillIcon"
                            android:src="@drawable/ic_video_library"
                            app:tint="@color/on_surface" />

                        <TextView
                            style="@style/ActionPillText"
                            android:text="@string/action_playlist" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/actionShare"
                        style="@style/ActionPill">

                        <ImageView
                            style="@style/ActionPillIcon"
                            android:src="@drawable/ic_share"
                            app:tint="@color/on_surface" />

                        <TextView
                            style="@style/ActionPillText"
                            android:text="@string/action_share" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/actionPip"
                        style="@style/ActionPill">

                        <ImageView
                            style="@style/ActionPillIcon"
                            android:src="@drawable/ic_pip"
                            app:tint="@color/on_surface" />

                        <TextView
                            style="@style/ActionPillText"
                            android:text="@string/action_pip" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Live Offline Download Progress Bar Card on Video Player -->
            <LinearLayout
                android:id="@+id/downloadProgressContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_soft"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/downloadProgressLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/download_status_running"
                        android:textColor="@color/on_surface"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/downloadBytesLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/downloadProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/np_scrubber" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/commentsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_soft"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chat_bubble"
                        app:tint="?attr/accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/comments_title"
                        android:textColor="@color/on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/commentsCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/on_surface_variant" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/commentsPreviewRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/commentsPreviewAvatar"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/CircleImage" />

                    <TextView
                        android:id="@+id/commentsPreviewText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/on_surface"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/commentsStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/comments_loading"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:alpha="0.25"
                android:background="@color/outline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp"
                android:letterSpacing="-0.01"
                android:text="@string/related_videos"
                android:textColor="@color/on_surface"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/relatedList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/errorView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/errorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/on_surface_variant" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/retry"
            android:visibility="visible" />

        <Button
            android:id="@+id/errorSignInButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/youtube_unlock_sign_in_btn"
            android:visibility="gone" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
