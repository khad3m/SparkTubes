<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle outer ambient track -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="#28FFFFFF" />
            <size android:height="6dp" />
        </shape>
    </item>
    <!-- Secondary buffered shimmer layer -->
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="999dp" />
                <solid android:color="#4DFFFFFF" />
                <size android:height="6dp" />
            </shape>
        </clip>
    </item>
    <!-- Active luminous gradient progress bar with neon edge highlight -->
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="999dp" />
                <gradient
                    android:angle="0"
                    android:startColor="#FFFF0033"
                    android:centerColor="#FFFF375F"
                    android:endColor="#FFFFFFFF" />
                <size android:height="6dp" />
            </shape>
        </clip>
    </item>
</layer-list>
